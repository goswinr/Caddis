<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- One build per runtime of Revit. net48 for Revit 2024 on .NET Framework, its panel with Avalonia 11: Avalonia 12 needs .NET 8.
    net8.0 for Revit 2025 and 2026 up to their .4 updates, net10.0 for Revit 2025.5, 2026.5 and later updates, and Revit 2027.
    Caddis.Revit.Loader picks between net8.0 and net10.0 when Revit starts.
    WPF for the docking shell, ribbon icons and clipboard; the panel content is shared Avalonia. -->
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Caddis.Revit</RootNamespace>
    <AssemblyName>Caddis.Revit</AssemblyName>
    <AssemblyTitle>Caddis</AssemblyTitle>
    <Description>An F# interactive host for Revit, controlled via HTTP and MCP.</Description>
    <!-- copy FSharp.Core, FSharp.Compiler.Service and Caddis.Core next to the dll.
    Fesh.Revit found that without it FSharp.Core fails to load in Revit 2025. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Revit provides its API at runtime. On .NET, Revit fails to load an add-in that references a higher version of RevitAPI than its own,
  so each build references the oldest Revit it runs in: net10.0 too, Revit 2025.5 has RevitAPI 25.5.
  The 2025 package has net8.0 reference assemblies, they work from net10.0 too. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2024.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="FSharp.Core" Version="10.1.401" /> <!-- the version that FCS pins in the net48 build of Caddis.Core -->
    <PackageReference Include="Avalonia.Win32" Version="11.3.22" />
    <Reference Include="UIAutomationClient" /> <!-- for RevitDialogs, part of WPF on .NET -->
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2025.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="FSharp.Core" Version="8.0.403" /> <!-- the version that FCS pins in the net8.0 build of Caddis.Core -->
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="FSharp.Core" Version="10.1.401" /> <!-- the version that FCS pins in the net10.0 build of Caddis.Core -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Caddis.Core/Caddis.Core.fsproj" />
    <ProjectReference Include="../Caddis.UI/Caddis.UI.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Log.fs" />
    <Compile Include="ApiContext.fs" />
    <Compile Include="Script.fs" />
    <Compile Include="RevitInfo.fs" />
    <Compile Include="RevitDialogs.fs" />
    <Compile Include="RevitHost.fs" />
    <Compile Include="App.fs" />
    <Compile Include="AvaloniaHost.fs" />
    <Compile Include="PanelTheme.fs" />
    <Compile Include="Panel.fs" />
    <Compile Include="RibbonIcons.fs" />
    <Compile Include="RibbonSettings.fs" />
    <Compile Include="Updates.fs" />
    <Compile Include="Addin.fs" />
  </ItemGroup>
  <!-- Revit runs on Windows x64. Software rendering needs neither ANGLE nor native debug symbols. -->
  <Target Name="RemoveUnusedNativeLibraries" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeIdentifier)' != 'win-x64'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'Avalonia.Angle.Windows.Natives' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <!-- On .NET Framework SkiaSharp and HarfBuzzSharp put their native libraries in a folder per architecture, see Directory.Build.targets.
  Revit 2024 needs only x64. Those for arm64 come along with Caddis.UI, which keeps them for Rhino. -->
  <Target Name="RemoveArm64NativeLibraries" AfterTargets="Build;Publish" Condition="'$(TargetFramework)' == 'net48'">
    <RemoveDir Directories="$(OutDir)arm64;$(PublishDir)arm64" />
  </Target>
</Project>
