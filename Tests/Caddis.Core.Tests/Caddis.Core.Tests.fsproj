<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 like Rhino 8, net10.0 like Revit 2026.5 -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- the versions that FCS pins in the builds of Caddis.Core -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="FSharp.Core" Version="8.0.403" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Caddis.Core/Caddis.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Helpers.fs" />
    <Compile Include="EvalTests.fs" />
    <Compile Include="BackgroundTests.fs" />
    <Compile Include="HttpTests.fs" />
    <Compile Include="CommandTests.fs" />
    <Compile Include="HostTests.fs" />
    <Compile Include="OutputTests.fs" />
    <Compile Include="ApiDocsTests.fs" />
  </ItemGroup>
</Project>
