<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Caddis.Rhino"
             xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
             x:Class="Caddis.Rhino.PanelView"
             Background="{DynamicResource Caddis.Panel}"
             Foreground="{DynamicResource Caddis.Text}"
             FontSize="12">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/PanelStyles.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Groups of controls that wrap as a whole when the panel is narrow. -->
    <Style Selector="StackPanel.row">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="4" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="WrapPanel.settings > :is(Control)">
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <!-- The chevron of the Settings button points up while the settings are shown, its color follows the button's text. -->
    <Style Selector="Path.chevron">
      <Setter Property="Stroke" Value="{DynamicResource Caddis.ButtonText}" />
    </Style>
    <Style Selector="ToggleButton:pointerover Path.chevron">
      <Setter Property="Stroke" Value="{DynamicResource Caddis.Text}" />
    </Style>
    <Style Selector="ToggleButton:checked Path.chevron">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="Grid.runColumns > TextBlock">
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ae|TextArea">
      <Setter Property="SelectionBrush" Value="{DynamicResource Caddis.Selection}" />
      <Setter Property="SelectionForeground" Value="{DynamicResource Caddis.SelectionText}" />
      <Setter Property="SelectionCornerRadius" Value="0" />
    </Style>
  </UserControl.Styles>

  <!-- The light or dark variant of the Fluent theme, for scroll bars and menus, set by PanelTheme. -->
  <ThemeVariantScope x:Name="Scope">
    <ThemeVariantScope.Styles>
      <!-- The themes of AvaloniaEdit's text area and search panel. They take resources from the Fluent theme,
           of the application, or of this view if another plugin started Avalonia, see PanelView.fs.
           Inside the scope, so that the colors of the search panel follow its theme variant, not the one of Windows. -->
      <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </ThemeVariantScope.Styles>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="48" />
        <RowDefinition Height="6" />
        <RowDefinition Height="*" MinHeight="60" />
      </Grid.RowDefinitions>

      <!-- The logo beside the status line and the buttons. Their groups wrap below each other when the panel is narrow. -->
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,4">
        <Border x:Name="Logo" Grid.RowSpan="2" VerticalAlignment="Top" Background="Transparent" Cursor="Hand" Margin="0,2,8,0">
          <Image x:Name="LogoImage" Width="40" Height="40" />
        </Border>
        <WrapPanel Grid.Column="1" Margin="0,2,0,2">
          <TextBlock x:Name="ServerStatus" TextWrapping="Wrap" Margin="0,0,16,0" />
          <TextBlock x:Name="FsiStatus" TextWrapping="Wrap" />
        </WrapPanel>
        <WrapPanel Grid.Row="1" Grid.Column="1">
          <StackPanel Classes="row">
            <Button x:Name="StartStop" Content="Start" MinWidth="56" />
            <Button x:Name="CopyMcp" Content="Copy MCP command" />
            <Button x:Name="CopyToken" Content="Copy token" />
          </StackPanel>
          <StackPanel Classes="row">
            <Button x:Name="Cancel" Content="Cancel run" />
            <Button x:Name="Reset" Content="Reset FSI session" />
            <ToggleButton x:Name="SettingsToggle">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Settings" />
                <Path Classes="chevron" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 8,0" StrokeThickness="1.2" />
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </WrapPanel>
      </Grid>

      <!-- Folded until the Settings button is checked. -->
      <Border x:Name="Settings" Grid.Row="1" IsVisible="{Binding #SettingsToggle.IsChecked}" Margin="0,0,0,4" Padding="8,2,0,2"
              BorderBrush="{DynamicResource Caddis.Divider}" BorderThickness="1" CornerRadius="2">
        <WrapPanel Classes="settings">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock x:Name="ModeLabel" Text="Run scripts on:" VerticalAlignment="Center" />
            <ComboBox x:Name="Mode" MinWidth="130">
              <ComboBoxItem Content="UI thread" />
              <ComboBoxItem Content="Background thread" />
            </ComboBox>
          </StackPanel>
          <CheckBox x:Name="AutoStart" Content="Start with Rhino" />
          <CheckBox x:Name="Echo" Content="Echo output to the command line" />
          <CheckBox x:Name="Lan" Content="Listen on the network (LAN)" />
          <CheckBox x:Name="CancelWaiting" Content="Cancel commands in scripts that wait for input" />
        </WrapPanel>
      </Border>

      <!-- The recent runs, newest first. The columns share their widths with the header. -->
      <Border Grid.Row="2" Background="{DynamicResource Caddis.Surface}" BorderBrush="{DynamicResource Caddis.Border}" BorderThickness="1">
        <Grid RowDefinitions="Auto,*" Grid.IsSharedSizeScope="True">
          <Border BorderBrush="{DynamicResource Caddis.Divider}" BorderThickness="0,0,0,1" Padding="0,3">
            <Grid Classes="runColumns">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Run" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Status" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Time" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Run" />
              <TextBlock Grid.Column="1" Text="Status" />
              <TextBlock Grid.Column="2" Text="Time" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Text="Code" />
            </Grid>
          </Border>
          <ListBox x:Name="Runs" Grid.Row="1" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:RunRow">
                <Grid Classes="runColumns">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Run" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Status" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Time" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Id}" />
                  <TextBlock Grid.Column="1" Text="{Binding Status}" />
                  <TextBlock Grid.Column="2" Text="{Binding Time}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding Code}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Row="3" ResizeDirection="Rows" Cursor="SizeNorthSouth" />

      <TabControl Grid.Row="4">
        <TabItem Header="Output">
          <TextBox x:Name="Output" Theme="{StaticResource Caddis.OutputTextBox}" />
        </TabItem>
        <TabItem Header="Code">
          <!-- Read-only: the code of a run can be selected, copied and searched with Ctrl+F, not changed. -->
          <ae:TextEditor x:Name="CodeView" Theme="{StaticResource Caddis.CodeEditor}" IsReadOnly="True" ShowLineNumbers="True"
                         LineNumbersMargin="4,0,6,0" FontFamily="Consolas, Menlo, Courier New" />
        </TabItem>
      </TabControl>
    </Grid>
  </ThemeVariantScope>
</UserControl>
