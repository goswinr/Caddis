<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Rhino 8 on .NET 8, Windows and Mac. net48 for Rhino 8 on .NET Framework, without the panel: Avalonia 12 needs .NET 8.
    net10.0 for Rhino 9. -->
    <TargetFrameworks>net8.0;net10.0;net48</TargetFrameworks>
    <TargetExt>.rhp</TargetExt>
    <RootNamespace>Caddis.Rhino</RootNamespace>
    <AssemblyName>Caddis.Rhino</AssemblyName>
    <AssemblyTitle>Caddis</AssemblyTitle>
    <!-- Yak compares this with the package version; keep the git hash out of it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>An F# interactive host for Rhino, controlled via HTTP and MCP.</Description>
    <!-- copy FSharp.Core, FSharp.Compiler.Service and Caddis.Core next to the .rhp -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Caddis.Core/Caddis.Core.fsproj" />
  </ItemGroup>

  <!-- Rhino provides RhinoCommon, Eto and Rhino.UI at runtime -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="RhinoCommon" Version="8.19.25132.1001" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Rhino 9 Beta, the same version as Fesh.Rhino -->
    <PackageReference Include="RhinoCommon" Version="9.0.26209.18303-beta" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- a dependency of RhinoCommon, provided by .NET (Windows) or Rhino (Mac) at runtime -->
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="FSharp.Core" Version="8.0.403" /> <!-- the version that FCS pins in the net8.0 build of Caddis.Core -->
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="FSharp.Core" Version="10.1.401" /> <!-- the version that FCS pins in the net10.0 build of Caddis.Core -->
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="FSharp.Core" Version="10.1.401" /> <!-- the version that FCS pins in the net48 build of Caddis.Core -->
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <!-- Platform backends for the shared Avalonia panel in Rhino's Eto shell. -->
    <PackageReference Include="Avalonia.Win32" Version="12.1.3" />
    <PackageReference Include="Avalonia.Native" Version="12.1.3" />
    <ProjectReference Include="../Caddis.UI/Caddis.UI.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../Docs/img/favicon.ico" Link="Resources/Caddis.ico" LogicalName="Caddis.Rhino.Resources.Caddis.ico" />
    <EmbeddedResource Include="../Docs/img/logo128.png" Link="Resources/Caddis.png" LogicalName="Caddis.Rhino.Resources.Caddis.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="RhinoInfo.fs" />
    <Compile Include="RunBorder.fs" />
    <Compile Include="RhinoHost.fs" />
    <Compile Include="App.fs" />
    <Compile Include="AvaloniaHost.fs" Condition="'$(TargetFramework)' != 'net48'" />
    <Compile Include="PanelTheme.fs" Condition="'$(TargetFramework)' != 'net48'" />
    <Compile Include="Panel.fs" Condition="'$(TargetFramework)' != 'net48'" />
    <Compile Include="PlugIn.fs" />
    <Compile Include="Commands.fs" />
  </ItemGroup>

  <!-- Rhino 8 runs on 64 bit Windows and Mac only. The panel renders in software, so ANGLE's libraries aren't needed either.
  This keeps the native libraries of x86, Linux and WebAssembly, and the 210 MB of SkiaSharp's native debug symbols,
  out of the build and the Yak package. -->
  <Target Name="RemoveUnusedNativeLibraries" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeIdentifier)' != 'win-x64' and '%(RuntimeIdentifier)' != 'win-arm64' and '%(RuntimeIdentifier)' != 'osx'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'Avalonia.Angle.Windows.Natives' or '%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <Target Name="WriteChangelogVersion" AfterTargets="AfterBuild" DependsOnTargets="SetVersionFromChangelog">
    <Error Condition="'@(CurrentReleaseChangelog)' == ''" Text="CHANGELOG.md must contain a versioned release for Yak packaging." />
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/bin/ChangelogVersion.txt" Lines="@(CurrentReleaseChangelog)" Overwrite="true" />
  </Target>
</Project>
