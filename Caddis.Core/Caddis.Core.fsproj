<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- plain net8.0, no WPF, so that it runs in Rhino 8 on Windows and Mac. net10.0 for Revit 2026.5. net48 for Rhino on .NET Framework. -->
    <TargetFrameworks>net8.0;net10.0;net48</TargetFrameworks>
    <RootNamespace>Caddis</RootNamespace>
    <AssemblyName>Caddis.Core</AssemblyName>
    <Description>Hosts F# Interactive in a .NET app and controls it via HTTP and MCP.</Description>
  </PropertyGroup>

  <!-- FSharp.Compiler.Service pins the exact version of FSharp.Core. Projects that reference Caddis.Core must use the same FSharp.Core.
  Each pair is the same as in the build of Fesh for that framework, so that Caddis and Fesh can be loaded in the same process. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Like Fesh 0.34.0-net8 and Fesh.Rhino. Newer FCS versions depend on System.Diagnostics.DiagnosticSource 9+,
    which does not load in Rhino 8. See https://github.com/dotnet/fsharp/issues/19174 -->
    <PackageReference Include="FSharp.Compiler.Service" Version="43.8.403" />
    <PackageReference Include="FSharp.Core" Version="8.0.403" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Like Fesh 0.34.0-net10 -->
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.401" />
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Like Fesh 0.34.0-net472. System.Text.Json is in-box only on .NET Core, this version matches the 10.0.2 dependencies of FCS. -->
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.401" />
    <PackageReference Include="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="System.Text.Json" Version="10.0.2" />
    <!-- HttpClient, to ask another Caddis to hand over its port -->
    <Reference Include="System.Net.Http" />
    <!-- ZipArchive, for the extension of Claude Desktop -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <!-- The relay and icon of the extension of Claude Desktop, see DesktopExtension.fs -->
  <ItemGroup>
    <EmbeddedResource Include="ClaudeDesktop/relay.js" LogicalName="Caddis.Core.ClaudeDesktop.relay.js" />
    <EmbeddedResource Include="../Docs/img/logo512.png" Link="ClaudeDesktop/icon.png" LogicalName="Caddis.Core.ClaudeDesktop.icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Compat.fs" />
    <Compile Include="ReleaseVersion.fs" />
    <Compile Include="ErrorLog.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="DotnetSdk.fs" />
    <Compile Include="Settings.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Script.fs" />
    <Compile Include="ApiDocs.fs" />
    <Compile Include="Worker.fs" />
    <Compile Include="FsiHost.fs" />
    <Compile Include="Service.fs" />
    <Compile Include="DesktopExtension.fs" />
    <Compile Include="McpAgents.fs" />
    <Compile Include="Http/Types.fs" />
    <Compile Include="Http/Rest.fs" />
    <Compile Include="Http/McpView.fs" />
    <Compile Include="Http/Mcp.fs" />
    <Compile Include="Server.fs" />
    <Compile Include="HeadlessHost.fs" />
  </ItemGroup>
</Project>
